APP_NAME="Grameen Bazar"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=single
LOG_LEVEL=debug

# XAMPP ডিফল্ট: user=root, password ফাঁকা। phpMyAdmin এ "grameen_bazar" নামে ডাটাবেস বানান
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=grameen_bazar
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# true হলে নতুন বিজ্ঞাপন সাথে সাথে লাইভ হয় (অ্যাডমিন প্যানেল আসার পর false করে দিন)
ADS_AUTO_APPROVE=true

# প্রোডাকশনে ফ্রন্টএন্ড আলাদা ডোমেইনে থাকলে সেই ডোমেইন দিন (কমা দিয়ে একাধিক)
CORS_ALLOWED_ORIGINS=*
